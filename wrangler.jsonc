/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 * After changing bindings or the compatibility date, run `pnpm cf-typegen`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotivalo",
  "compatibility_date": "2026-11-13",
  // Required by TanStack Start (AsyncLocalStorage etc.). It is a partial
  // polyfill, not Node: still avoid Node-specific dependencies.
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // The top level is local development and tests; deployed environments are
  // under "env" below. Bindings and vars are not inherited by an environment,
  // so each one lists all of them.
  //
  // D1 database. Only src/server/platform/ reads this binding. Migrations are
  // generated by drizzle-kit (pnpm db:generate) and applied by Wrangler.
  // Local development and tests need no database_id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kotivalo",
      "migrations_dir": "migrations",
    },
  ],
  // Private file storage for receipts and attachments. Only
  // src/server/platform/ reads this binding; files are served through the
  // Worker after an access check.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kotivalo-files",
    },
  ],
  // Email (src/server/platform/mailer.server.ts). "capture" keeps messages in
  // memory and logs them, so local development and tests never call Resend.
  // Deployed environments set "resend", a verified sender domain in
  // EMAIL_FROM and the RESEND_API_KEY secret. Locally the key goes in
  // .dev.vars (see .dev.vars.example).
  //
  // BETTER_AUTH_SECRET signs session cookies (platform/auth.server.ts). This
  // value is for local development and tests only and is public; production
  // has its own secret: wrangler secret put BETTER_AUTH_SECRET --env production
  "vars": {
    "EMAIL_TRANSPORT": "capture",
    "EMAIL_FROM": "Kotivalo <noreply@example.com>",
    "BETTER_AUTH_SECRET": "local-development-only-not-a-secret-0123456789",
    // The lowest log level written (src/server/log/log.ts).
    "LOG_LEVEL": "debug",
  },
  // Workers Logs and automatic tracing (D1, fetch). Free plan: 200,000
  // events a day, kept 3 days; every request is traced while that suffices.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // The deployed version (id and tag = git commit) on every log line.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "upload_source_maps": true,
  "env": {
    // Deployed from develop by CI (.github/workflows/ci.yml, job "deploy").
    // D1 and R2 are in the EU jurisdiction: data is stored and processed
    // only in the EU. Secrets (wrangler secret put <NAME> --env production):
    // RESEND_API_KEY and BETTER_AUTH_SECRET.
    "production": {
      "name": "kotivalo",
      // No per-version preview URLs: they would be public and use the
      // production database, bucket and email.
      "preview_urls": false,
      // The Worker is served on its own domain only. Wrangler creates the DNS
      // records and certificates for a custom domain on deploy, so don't add
      // records for these names by hand.
      "workers_dev": false,
      "routes": [
        { "pattern": "kotivalo.app", "custom_domain": true },
        { "pattern": "www.kotivalo.app", "custom_domain": true },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kotivalo",
          "database_id": "faa0904b-5be1-4c57-af77-d37c06e52c7c",
          "migrations_dir": "migrations",
        },
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "kotivalo-files",
          "jurisdiction": "eu",
        },
      ],
      // Sends through Resend from a domain verified there (EU region). The
      // sender domain is temporary until Kotivalo has its own domain.
      "vars": {
        "EMAIL_TRANSPORT": "resend",
        "EMAIL_FROM": "Kotivalo <noreply@k6.fi>",
        // Debug lines would use up the free plan's daily log events.
        "LOG_LEVEL": "info",
      },
    },
  },
}
