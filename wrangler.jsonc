/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 * After changing bindings or the compatibility date, run `pnpm cf-typegen`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotivalo",
  "compatibility_date": "2026-11-13",
  // Required by TanStack Start (AsyncLocalStorage etc.). It is a partial
  // polyfill, not Node: still avoid Node-specific dependencies.
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // D1 database. Only src/server/platform/ reads this binding. Migrations are
  // generated by drizzle-kit (pnpm db:generate) and applied by Wrangler.
  // database_id is set when the remote database is created (#14); local
  // development and tests don't need it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kotivalo",
      "migrations_dir": "migrations",
    },
  ],
  // Private file storage for receipts and attachments. Only
  // src/server/platform/ reads this binding; files are served through the
  // Worker after an access check. The bucket is created per environment (#14).
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kotivalo-files",
    },
  ],
  // Email (src/server/platform/mailer.server.ts). "capture" keeps messages in
  // memory and logs them, so local development and tests never call Resend.
  // Deployed environments set "resend", a verified sender domain in
  // EMAIL_FROM and the RESEND_API_KEY secret (#14). Locally the key goes in
  // .dev.vars (see .dev.vars.example).
  "vars": {
    "EMAIL_TRANSPORT": "capture",
    "EMAIL_FROM": "Kotivalo <noreply@example.com>",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
